# Backend environment for manual `uvicorn app.main:app` runs.
# scripts/start_local.sh exports these automatically; you only need this file
# when starting the API by hand.
#
#   set -a; source backend/.env; set +a
#   cd backend && ../.venv/bin/python -m uvicorn app.main:app --reload

# Canonical persistence variable — the backend does not read DATABASE_URL.
STAYNEST_DB_URL=postgresql+psycopg://staynest@127.0.0.1:55432/staynest
JWT_SECRET=dev-only-change-in-azure-key-vault

# SQLite is supported for quick checks (schema + deterministic seed still apply):
# STAYNEST_DB_URL=sqlite:///./staynest.db
