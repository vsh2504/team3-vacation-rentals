# StayNest — native one-command startup overrides.
# Copy to .env.local (gitignored). Every value is optional; the defaults below
# match scripts/start_local.sh and are shown so you can change one safely.
#
#   cp .env.local.example .env.local
#   ./scripts/start_local.sh

# Project-local PostgreSQL (trust auth on loopback, development only).
STAYNEST_PGPORT=55432
STAYNEST_PGHOST=127.0.0.1
STAYNEST_PGUSER=staynest
STAYNEST_PGDATABASE=staynest
# STAYNEST_PGDATA=/absolute/path/to/postgres-data

# Application ports.
STAYNEST_API_PORT=8000
STAYNEST_WEB_PORT=5173

# Set STAYNEST_RELOAD=1 to run uvicorn --reload for backend hot reload.
STAYNEST_RELOAD=0
JWT_SECRET=dev-only-change-in-azure-key-vault

# Use an existing database instead of the bundled cluster. When this is set,
# start_local.sh does not start or stop PostgreSQL.
# STAYNEST_DB_URL=postgresql+psycopg://user:password@127.0.0.1:5432/staynest
# STAYNEST_DB_URL=sqlite:///./staynest.db
