# StayNest — Docker Compose settings.
# Copy to .env (gitignored) before `docker compose up --build -d`.
# The native one-command script uses .env.local instead; see .env.local.example.

POSTGRES_USER=staynest
POSTGRES_PASSWORD=staynest-dev-only
POSTGRES_DB=staynest

# Host ports. Inside Compose the API and web containers always use 8000/5173.
STAYNEST_PGPORT=5432
STAYNEST_API_PORT=8000
STAYNEST_WEB_PORT=5173

# Development only. Use a real secret manager in deployed environments.
JWT_SECRET=dev-only-change-in-azure-key-vault
