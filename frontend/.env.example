# Frontend environment (Vite).
# Copy to frontend/.env only if you need to override the defaults.

# Browser API base. /api uses the Vite dev proxy; set an absolute URL only for
# a deployed build that talks to a remote API.
VITE_API_URL=/api

# Dev-server proxy target. scripts/start_local.sh and Docker Compose set
# STAYNEST_API_URL automatically; this is the manual override.
# STAYNEST_API_URL=http://127.0.0.1:8000
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: Google Maps embeds. OpenStreetMap is the default and needs no key.
# VITE_GOOGLE_MAPS_KEY=
